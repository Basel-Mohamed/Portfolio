# Supabase Credentials (Public Anon Client)
# Also read server-side by api/chat.ts to load the admin-edited chatbot prompt.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# AI chat (server-only — used by the api/chat.ts serverless function)
# Never prefix these with VITE_, or they will be shipped to the browser.
COHERE_API_KEY=your-cohere-api-key
# Optional, defaults to command-r7b-12-2024
# COHERE_MODEL=command-r7b-12-2024
