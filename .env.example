# Supabase Credentials (Public Anon Client)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend Service URL (FastAPI SSE Streaming LLM Service)
# In development, leave empty to use Vite proxy (/api -> localhost:8000)
# In production, set to your Cloud Run or server endpoint
VITE_API_URL=http://localhost:8000
